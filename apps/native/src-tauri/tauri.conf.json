{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Idle Mine Beyond",
  "version": "0.0.0",
  "identifier": "com.idleminebeyond.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web exec vite dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/build"
  },
  "app": {
    "windows": [
      {
        "title": "Idle Mine Beyond",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
